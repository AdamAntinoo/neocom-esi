{
  "name": "neocom-esi",
  "version": "0.1.0",
  "description": "EVE Online ESI classes and tools for NEOCOM",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
